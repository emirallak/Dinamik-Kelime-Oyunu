<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <RelativeLayout
            android:layout_width="60dp"
            android:layout_height="60dp">

            <TextView
                android:id="@+id/tvJokerIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:text="🐟"
                android:textSize="32sp"
                android:gravity="center"
                android:layout_centerInParent="true" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#D32F2F">

                <TextView
                    android:id="@+id/tvJokerBadge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"/>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvJokerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joker Adı"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJokerDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Açıklama metni buraya gelecek."
                android:textSize="14sp"
                android:textColor="#666666" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBuyJoker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 💰"
            android:textSize="14sp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>