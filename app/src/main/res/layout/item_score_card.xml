<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Sıralama numarası -->
        <TextView
            android:id="@+id/tvRank"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#534AB7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Üst satır: Oyun etiketi + Tarih -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvGameLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Oyun #1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01.01.2026"
                    android:textSize="11sp"
                    android:textColor="#888780"
                    android:background="@drawable/bg_pill_gray"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- Büyük skor -->
            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1240 puan"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#534AB7" />

            <!-- İstatistik satırı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GRİD" android:textSize="10sp" android:textColor="#888780" android:letterSpacing="0.05"/>
                    <TextView android:id="@+id/tvGrid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8×8" android:textSize="13sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KELİME" android:textSize="10sp" android:textColor="#888780" android:letterSpacing="0.05"/>
                    <TextView android:id="@+id/tvWordCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18" android:textSize="13sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SÜRE" android:textSize="10sp" android:textColor="#888780" android:letterSpacing="0.05"/>
                    <TextView android:id="@+id/tvDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6 dk" android:textSize="13sp" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- En uzun kelime pill -->
            <TextView
                android:id="@+id/tvLongestWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="KELİMELER"
                android:textSize="11sp"
                android:textColor="#3C3489"
                android:background="@drawable/bg_pill_purple"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>