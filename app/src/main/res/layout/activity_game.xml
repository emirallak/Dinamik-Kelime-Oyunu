<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Puan: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/tvMovesLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hamle: 25"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="end"
            android:textColor="#D32F2F"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvWordCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gridde Oluşturulabilir Kelime Sayısı: Hesaplanıyor..."
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <FrameLayout
        android:id="@+id/gameBoardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp">

    </FrameLayout>

    <TextView
        android:id="@+id/tvCurrentWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1976D2"
        android:layout_marginBottom="16dp"
        android:minHeight="40dp"/>

    <Button
        android:id="@+id/btnMarketJoker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jokerleri Kullan" />

</LinearLayout>