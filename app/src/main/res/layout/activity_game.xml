<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Puan: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tvMoveCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hamle: 15"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvAvailableWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sözlük yükleniyor..."
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:textColor="#666666"
        android:textSize="14sp"/>

    <FrameLayout
        android:id="@+id/gameBoardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnUseJoker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jokerleri Kullan"
            android:backgroundTint="#673AB7"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnFinishGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oyunu Bitir"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>